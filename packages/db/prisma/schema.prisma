generator client {
  provider = "prisma-client-js"
}

// PostgreSQL — use Neon/Render locally (see docker-compose.yml) or SQLite file for legacy dev
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  member
  manager
  super_admin
}

enum SubscriptionTier {
  basic
  standard
  premium
}

enum SubscriptionStatus {
  active
  suspended
  cancelled
}

enum ContentType {
  advert
  article
  education
  information
  picture
  video
}

enum CultureSystem {
  extensive
  semi_intensive
  intensive
  ras
}

enum MiscCostCategory {
  salary
  transport
  chemicals
  repairs
  other
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  surname            String?
  gender             String?
  ageRange           String?
  phone              String?
  postcode           String?
  lga                String?
  state              String?
  country            String?
  /// Multi-select activity categories (see MEMBER_CATEGORIES in shared-types)
  categories         String[]           @default([])
  estimatedFishOutputYear String?
  passwordHash       String?
  role               UserRole           @default(member)
  subscriptionTier   SubscriptionTier   @default(basic)
  subscriptionStatus SubscriptionStatus @default(active)
  /// Admin-granted access end (extends beyond or instead of Stripe period)
  subscriptionPaidUntil DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  farms              Farm[]
  posts              ContentPost[]
  messages           MemberMessage[]
  createdAt          DateTime           @default(now())
}

model MemberMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  pondId    String?
  pondLabel String?
  title     String
  body      String
  reportNum Int?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ContentPost {
  id         String      @id @default(cuid())
  type       ContentType
  title      String
  body       String
  mediaUrl   String?
  /// Where a sponsored post appears: home, article, information, picture, video
  placements String[]    @default([])
  authorId   String
  author     User        @relation(fields: [authorId], references: [id])
  published  Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Farm {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String?
  location  String
  postcode  String?
  lga       String?
  sizeSqM   Float?
  farmSizeAcres String?
  totalPonds Int?
  latitude  Float?
  longitude Float?
  city      String
  state     String
  country   String
  ponds     Pond[]
  marketProducts MarketProduct[]
  createdAt DateTime @default(now())
}

model Pond {
  id       String       @id @default(cuid())
  farmId   String
  farm     Farm         @relation(fields: [farmId], references: [id])
  name     String
  number   Int
  pondType String?
  lengthM  Float
  widthM   Float
  depthM   Float
  cycles   StockCycle[]
  createdAt DateTime    @default(now())
}

model StockCycle {
  id                   String              @id @default(cuid())
  pondId               String
  pond                 Pond                @relation(fields: [pondId], references: [id])
  fishSpecies          String?
  cultureSystem        CultureSystem?
  currency             String?             @default("NGN")
  quantityStocked      Int
  averageWeightAtStockingG Float
  fingerlingPrice      Float
  stockingDate         DateTime
  proposedSalesDate    DateTime?
  feedName             String?
  feedType             String?
  feedMaker            String?
  feedBags             Int?
  desiredCrudeProteinPct Float
  desiredFeedQuantityKg  Float
  waterSource          String?
  initialPh            Float?
  initialDissolvedOxygenMgL Float?
  mortalityLogs        DailyMortalityLog[]
  feedLogs             DailyFeedLog[]
  waterLogs            WaterParameterLog[]
  powerLogs            DailyPowerLog[]
  feedBrands           FeedBrandMonth[]
  salesLogs            FishSaleLog[]
  weightSamples        ActualWeightSample[]
  operationsLogs       DailyOperationsLog[]
  miscCostLogs         MiscCostLog[]
  feedIngredientCosts  FeedIngredientCost[]
  createdAt            DateTime            @default(now())
}

model DailyMortalityLog {
  id           String     @id @default(cuid())
  stockCycleId String
  stockCycle   StockCycle @relation(fields: [stockCycleId], references: [id])
  date         DateTime
  count        Int
  createdAt    DateTime   @default(now())

  @@unique([stockCycleId, date])
}

model DailyFeedLog {
  id           String     @id @default(cuid())
  stockCycleId String
  stockCycle   StockCycle @relation(fields: [stockCycleId], references: [id])
  date         DateTime
  actualKg     Float
  createdAt    DateTime   @default(now())

  @@unique([stockCycleId, date])
}

model WaterParameterLog {
  id                String     @id @default(cuid())
  stockCycleId      String
  stockCycle        StockCycle @relation(fields: [stockCycleId], references: [id])
  date              DateTime
  ph                Float?
  dissolvedOxygenMgL Float?
  temperatureC      Float?
  ammoniaMgL        Float?
  notes             String?
  createdAt         DateTime   @default(now())

  @@unique([stockCycleId, date])
}

model DailyPowerLog {
  id             String     @id @default(cuid())
  stockCycleId   String
  stockCycle     StockCycle @relation(fields: [stockCycleId], references: [id])
  date           DateTime
  electricityKwh Float?
  dieselLiters   Float?
  petrolLiters   Float?
  solarKwh       Float?
  notes          String?
  createdAt      DateTime   @default(now())

  @@unique([stockCycleId, date])
}

model FeedBrandMonth {
  id              String     @id @default(cuid())
  stockCycleId    String
  stockCycle      StockCycle @relation(fields: [stockCycleId], references: [id])
  month           Int
  brand           String
  feedSizeMm      Float
  costPerBag      Float
  crudeProteinPct Float
  createdAt       DateTime   @default(now())

  @@unique([stockCycleId, month])
}

model FishSaleLog {
  id           String     @id @default(cuid())
  stockCycleId String
  stockCycle   StockCycle @relation(fields: [stockCycleId], references: [id])
  date         DateTime
  quantitySold Int
  avgWeightG   Float?
  totalRevenue Float?
  customerName String?
  notes        String?
  createdAt    DateTime   @default(now())
}

model ActualWeightSample {
  id             String     @id @default(cuid())
  stockCycleId   String
  stockCycle     StockCycle @relation(fields: [stockCycleId], references: [id])
  date           DateTime
  averageWeightG Float
  sampleCount    Int?
  createdAt      DateTime   @default(now())

  @@unique([stockCycleId, date])
}

model MiscCostLog {
  id           String           @id @default(cuid())
  stockCycleId String
  stockCycle   StockCycle       @relation(fields: [stockCycleId], references: [id])
  date         DateTime
  category     MiscCostCategory
  amount       Float
  notes        String?
  createdAt    DateTime         @default(now())
}

model FeedIngredientCost {
  id             String     @id @default(cuid())
  stockCycleId   String
  stockCycle     StockCycle @relation(fields: [stockCycleId], references: [id])
  ingredientName String
  costPerKg      Float
  month          Int?
  createdAt      DateTime   @default(now())

  @@unique([stockCycleId, ingredientName])
}

model DailyOperationsLog {
  id             String     @id @default(cuid())
  stockCycleId   String
  stockCycle     StockCycle @relation(fields: [stockCycleId], references: [id])
  date           DateTime
  medication     Boolean    @default(false)
  grading        Boolean    @default(false)
  netWash        Boolean    @default(false)
  pondCleaning   Boolean    @default(false)
  aerationCheck  Boolean    @default(false)
  waterExchange  Boolean    @default(false)
  sampling       Boolean    @default(false)
  notes          String?
  createdAt      DateTime   @default(now())

  @@unique([stockCycleId, date])
}

enum FoodClass {
  protein
  carbohydrate
  others
}

/** Global feed formulation ingredients (admin Config) */
model GlobalIngredient {
  id              String    @id @default(cuid())
  name            String    @unique
  crudeProteinPct Float
  inclusionRatio  Float
  composition     String?
  foodClass       FoodClass
}

/** Global FCR / % body-weight coefficients for months 1–6 */
model FcrMonthConfig {
  month         Int   @id
  bodyWeightPct Float
  fcr           Float
}

model MarketCategory {
  id          String          @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  products    MarketProduct[]
  createdAt   DateTime        @default(now())
}

model MarketProduct {
  id          String          @id @default(cuid())
  farmId      String
  farm        Farm            @relation(fields: [farmId], references: [id])
  categoryId  String?
  category    MarketCategory? @relation(fields: [categoryId], references: [id])
  name        String
  price       Float
  quantity    Float
  imageUrl    String?
  description String?
  sold        Boolean         @default(false)
  createdAt   DateTime        @default(now())
}
