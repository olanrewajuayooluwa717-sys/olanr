# Fishmaster — environment variables
# Copy to `.env` at repo root for local development.
# Production values are set in Render, Vercel, and EAS (see DEPLOY.md).

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Web (Next.js) ─────────────────────────────────────────────────────────────
# Local dev
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production (set in Vercel, not here)
# NEXT_PUBLIC_API_URL=https://fishmaster-api.onrender.com

# Canonical web app URL — used for Stripe redirect URLs and CORS
WEB_URL=http://localhost:3000
# Production: https://your-app.vercel.app or https://fishmaster.ng

# Extra CORS origins (comma-separated) — e.g. Vercel preview deployments
# CORS_ORIGINS=https://fishmaster-git-main-username.vercel.app

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL (run: docker compose up -d)
DATABASE_URL=postgresql://fishmaster:fishmaster@localhost:5432/fishmaster
# Neon (production option): paste pooled connection string from Neon dashboard

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production — Render auto-generates via render.yaml
JWT_SECRET=fishmaster-dev-secret-change-in-prod

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys (test) or /apikeys (live)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── Economics (₦ power rates) ─────────────────────────────────────────────────
# Optional — defaults shown; override on Render for local market rates
ELECTRICITY_RATE_NGN=85
DIESEL_RATE_NGN=1200
PETROL_RATE_NGN=1100

# ── Deploy / ops ──────────────────────────────────────────────────────────────
# Set true ONLY on first production deploy to seed demo data, then false
SEED_ON_DEPLOY=false

# ── Mobile (Expo) — set in apps/mobile/.env, not root .env ───────────────────
# EXPO_PUBLIC_API_URL=http://192.168.1.71:3001
